{
  "name": "@weiki886/sight-mcp",
  "version": "0.0.0",
  "description": "A secure MCP vision bridge for text-only coding agents.",
  "license": "MIT",
  "author": "Weiki886",
  "type": "module",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sight-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weiki886/sight-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Weiki886/sight-mcp/issues"
  },
  "homepage": "https://github.com/Weiki886/sight-mcp#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-executable.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:integration && pnpm pack:check && pnpm audit:prod",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "node scripts/check-pack.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run tests/unit tests/contract tests/security",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
